# Copy to .env. Blank optional keys = feature skipped. Set AI_GATEWAY_API_KEY for the default model,
# or set LLM_PROVIDER=azure plus the Azure settings below (+ TELEGRAM_* for the bot).

# bot token (@BotFather)
TELEGRAM_TOKEN=
# your chat id — single-user gate (@userinfobot)
TELEGRAM_CHAT_ID=

# Default LLM inference, via Vercel AI Gateway (deepseek/deepseek-v4-pro)
AI_GATEWAY_API_KEY=

# Optional: run the same agent through Azure OpenAI's GPT-6-Sol deployment.
# Deployment names are specific to the Azure resource; set this to your actual deployment name.
LLM_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_RESOURCE_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=GPT-6-Sol
# Only set for an endpoint that requires a non-v1 api-version.
AZURE_OPENAI_API_VERSION=

# http surface (Siri Shortcuts etc). HTTP_AUTH_TOKEN required to enable it;
# POST /ask { text } (Bearer auth) runs a turn and returns { reply }.
# HTTP_PORT default 8787.
HTTP_AUTH_TOKEN=
HTTP_PORT=

# bash cwd + file-tool root. default ./workspace
WORKSPACE_ROOT=
# memory dir, relative to WORKSPACE_ROOT. default memory
MEMORY_ROOT=

# web search (Tavily)
TAVILY_API_KEY=
# Gmail + Calendar (Composio) — both required
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Laminar tracing key
LMNR_PROJECT_API_KEY=
# self-hosted Laminar (optional)
LMNR_BASE_URL=
LMNR_HTTP_PORT=
LMNR_GRPC_PORT=

# The eval suite uses Azure; export AZURE_OPENAI_API_KEY and AZURE_OPENAI_ENDPOINT
# (or use AZURE_RESOURCE_NAME) in the shell or an ignored .env file before running it.
